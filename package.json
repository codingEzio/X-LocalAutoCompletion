{
  "name": "x-local-auto-completion",
  "displayName": "X-LocalAutoCompletion",
  "description": "Fast local word completion from the current file and offline English.",
  "version": "0.4.1",
  "publisher": "alex",
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "autocomplete",
    "completion",
    "local",
    "offline",
    "english"
  ],
  "galleryBanner": {
    "color": "#182033",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "X-LocalAutoCompletion",
      "properties": {
        "localAutoCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable local file and English word completions."
        },
        "localAutoCompletion.minimumPrefixLength": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 6,
          "scope": "resource",
          "description": "Characters required before a completion is offered."
        }
      }
    }
  }
}
