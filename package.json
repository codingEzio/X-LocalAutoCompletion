{
  "name": "x-local-auto-completion",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.5.0",
  "publisher": "alex",
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "autocomplete",
    "completion",
    "local",
    "offline",
    "english"
  ],
  "galleryBanner": {
    "color": "#182033",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "localAutoCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%configuration.enabled.description%"
        },
        "localAutoCompletion.minimumPrefixLength": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 6,
          "scope": "resource",
          "description": "%configuration.minimumPrefixLength.description%"
        }
      }
    }
  }
}
